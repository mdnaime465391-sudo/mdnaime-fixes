APP_NAME="Md Naime"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database — fill in your hosting credentials (MySQL/MariaDB or PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions — secure cookie requires working HTTPS
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

# Mail — set to smtp + your provider credentials before launch;
# "log" keeps outgoing mail in storage/logs so nothing ever fatals.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# First-run admin account — used by `php artisan db:seed`.
# Remove ADMIN_PASSWORD from this file after the first seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true only if you want the 9 sample projects on production.
SEED_DEMO=false
